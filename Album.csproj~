<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="**\*.glade" />
    <EmbeddedResource Include="**\*.glade">
      <LogicalName>%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FileSystemLinks" Version="1.0.3" />
    <PackageReference Include="GtkSharp" Version="3.24.24.*" />
  </ItemGroup>

  <ItemGroup>	
    <None Include="Baukasten\**\*" CopyToOutputDirectory="PreserveNewest"
          Link="Baukasten\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- analog für Create-CSS, Fotoalben, Muster -->
  </ItemGroup>

  <ItemGroup>
    <None Include="Create-CSS\**\*" CopyToOutputDirectory="PreserveNewest"
          Link="Create-CSS\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fotoalben\**\*" CopyToOutputDirectory="PreserveNewest"
          Link="Fotoalben\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Muster\**\*" CopyToOutputDirectory="PreserveNewest"
          Link="Muster\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
